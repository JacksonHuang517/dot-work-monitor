# Required: fill these locally; never commit your real .env.
PUBLIC_ORIGIN=
FEISHU_APP_ID=
FEISHU_TENANT_KEY=
OWNER_OPEN_ID=
OWNER_DISPLAY_NAME=Owner
# Optional mailbox: set true and fill username to enable headers-only INBOX checks.
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_HOST=imap.qiye.163.com
# Non-sensitive collection settings.
CHAT_IDS=["*"]
CALENDAR_IDS=["primary"]
POLL_SECONDS=300

# New OAuth clients are accepted only until this UTC timestamp.
# setup.py opens a 24-hour first-connection window; blank disables registration.
DCR_REGISTRATION_UNTIL=
