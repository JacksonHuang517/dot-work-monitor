# Required identity and origin. Copy values from your own application/account.
PUBLIC_ORIGIN=
FEISHU_APP_ID=
OWNER_OPEN_ID=
FEISHU_TENANT_KEY=
OWNER_DISPLAY_NAME=Owner

# Required absolute protected files (0600 or more restrictive).
FEISHU_APP_SECRET_FILE=/run/monitor-secrets/feishu-app-secret
INTERNAL_KEY_FILE=/run/monitor-secrets/internal-key
AUTH_DB_KEY_FILE=/run/monitor-secrets/auth-db-key
OAUTH_JWKS_FILE=/run/monitor-secrets/jwks.json
COOKIE_KEYS_FILE=/run/monitor-secrets/cookie-keys.json
AUTH_DATABASE_PATH=/var/lib/monitor/auth.sqlite

# Optional preconfigured native client. Usually use restricted DCR instead.
OAUTH_CLIENT_ID=
OAUTH_REDIRECT_URIS=[]
# Open registration briefly while connecting a new client; blank disables new clients.
DCR_REGISTRATION_UNTIL=

# Keep loopback unless an isolated ingress network provides the trust boundary.
AUTH_HOST=127.0.0.1
AUTH_PORT=8560
AUTH_TRUST_PROXY=loopback
