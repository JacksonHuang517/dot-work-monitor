{
  "name": "dotsignal-auth",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "generate-keys": "node --import tsx src/generate-keys.ts"
  },
  "dependencies": {
    "express": "5.1.0",
    "jose": "6.2.3",
    "oidc-provider": "9.13.3"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "22.15.30",
    "@types/oidc-provider": "9.5.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
